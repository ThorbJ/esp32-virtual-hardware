{
  "formatVersion": 2,
  "device": { "id": "test-device" },
  "appliesTo": { "kit": "test-kit", "options": [] },
  "firmware": {
    "version": "0.1.0",
    "upstream": { "repo": "https://github.com/ThorbJ/esp32-virtual-hardware", "commit": "<filled in by build.mjs>" },
    "virtualDevice": { "repo": "https://github.com/ThorbJ/esp32-virtual-hardware", "commit": "<filled in by build.mjs>" },
    "license": { "spdx": "MIT", "unofficial": false, "files": ["licenses/LICENSE"] }
  },
  "runtime": { "interfaceVersion": 3, "module": "firmware/test-device.mjs", "memoryMB": 64, "threads": 8, "virtualTime": true },
  "channels": { "in": ["button", "hostRx", "hostPresent"], "out": ["screen", "servo", "hostTx", "log"] },
  "screen": {
    "node": "screen",
    "panel": { "width": 160, "height": 128, "format": "rgb565" },
    "rotateCW": 0,
    "area": { "x": 0, "y": 0, "width": 1, "height": 1 },
    "background": "#000000"
  },
  "inputs": [{ "kind": "button", "node": "button", "button": 0, "press": { "offsetMm": [0, 0, -1.5] } }],
  "servos": [
    {
      "id": 0, "nodes": ["arm"], "pivot": [20, 69, 0], "axis": [0, 1, 0], "zeroDeg": 90, "direction": 1, "scale": 1,
      "approximate": { "zh": "舵臂按舵机角度 1:1 转动（测试用模型）。", "en": "The arm follows the servo angle 1:1 (test model)." }
    }
  ],
  "hostLink": { "port": 47615, "path": "/", "protocol": "echo" }
}
